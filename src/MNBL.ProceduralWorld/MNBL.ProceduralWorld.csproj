<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <OutputType>Library</OutputType>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
    <AssemblyName>MNBL.ProceduralWorld</AssemblyName>
    <RootNamespace>MNBL.ProceduralWorld</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputPath>../../build/module/</OutputPath>
    <GameRoot Condition="'$(GameRoot)'==''">D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</GameRoot>
    <GameBin>$(GameRoot)\bin\Win64_Shipping_Client</GameBin>
    <WorkshopRoot Condition="'$(WorkshopRoot)'==''">D:\SteamLibrary\steamapps\workshop\content\261550</WorkshopRoot>
  </PropertyGroup>
  <ItemGroup>
    <!-- MMR-36: the graph validation policy every registration is validated against (CampaignGraphValidator.InstalledPolicy). -->
    <EmbeddedResource Include="..\..\worldgen\policies\graph-validation.json" LogicalName="MNBL.ProceduralWorld.graph-validation.json" />
    <!-- MMR-38: the navigation policy every compiled world's navmesh is built and validated with (NavigationPolicy.Installed). -->
    <EmbeddedResource Include="..\..\worldgen\policies\navigation.json" LogicalName="MNBL.ProceduralWorld.navigation.json" />
    <!-- MMR-40: the settlement placement policy and the MMR-35 blockade arc the scene markers are resolved with (SettlementPlacementPolicy.Installed). -->
    <EmbeddedResource Include="..\..\worldgen\policies\settlement-placement.json" LogicalName="MNBL.ProceduralWorld.settlement-placement.json" />
    <EmbeddedResource Include="..\..\worldgen\policies\naval-content.json" LogicalName="MNBL.ProceduralWorld.naval-content.json" />
    <!-- MMR-38: the MMR-17 observed War Sails navigation values the installed model is compared with (NavigationModel). -->
    <EmbeddedResource Include="..\..\worldgen\calibration\naval-transitions\naval-transitions.json" LogicalName="MNBL.ProceduralWorld.naval-transitions.json" />
    <!-- MMR-43: the New Campaign setup screen's documents (WorldSetupContract.Installed). -->
    <EmbeddedResource Include="..\..\worldgen\profiles\one-shot.json" LogicalName="MNBL.ProceduralWorld.one-shot.json" />
    <EmbeddedResource Include="..\..\worldgen\contracts\producer-controls.json" LogicalName="MNBL.ProceduralWorld.producer-controls.json" />
    <EmbeddedResource Include="..\..\worldgen\contracts\producer-seed-width.json" LogicalName="MNBL.ProceduralWorld.producer-seed-width.json" />
    <EmbeddedResource Include="..\..\worldgen\policies\product-policy.json" LogicalName="MNBL.ProceduralWorld.product-policy.json" />
    <EmbeddedResource Include="..\..\worldgen\policies\one-shot-budget.json" LogicalName="MNBL.ProceduralWorld.one-shot-budget.json" />
    <EmbeddedResource Include="..\..\worldgen\producer.lock.json" LogicalName="MNBL.ProceduralWorld.producer.lock.json" />
    <EmbeddedResource Include="..\..\worldgen\policies\culture-presentations.json" LogicalName="MNBL.ProceduralWorld.culture-presentations.json" />
    <!-- MMR-44: the generation job's policy inputs (worldbridge new-request, generate and bundle), written into each job and verified. -->
    <EmbeddedResource Include="..\..\worldgen\policies\world-quality.json" LogicalName="MNBL.ProceduralWorld.world-quality.json" />
    <EmbeddedResource Include="..\..\worldgen\contracts\source-compatibility.json" LogicalName="MNBL.ProceduralWorld.source-compatibility.json" />
    <EmbeddedResource Include="..\..\worldgen\policies\projection.json" LogicalName="MNBL.ProceduralWorld.projection.json" />
    <EmbeddedResource Include="..\..\worldgen\policies\terrain-materials.json" LogicalName="MNBL.ProceduralWorld.terrain-materials.json" />
    <EmbeddedResource Include="..\..\worldgen\calibration\terrain-import\terrain-import.json" LogicalName="MNBL.ProceduralWorld.terrain-import.json" />
    <EmbeddedResource Include="..\..\worldgen\policies\campaign-content.json" LogicalName="MNBL.ProceduralWorld.campaign-content.json" />
    <EmbeddedResource Include="..\..\worldgen\policies\playability.json" LogicalName="MNBL.ProceduralWorld.playability.json" />
    <!-- MMR-42: the mission scene catalogue and contracts every generated world's scene choices are made and checked with (MissionScenes.Installed). -->
    <EmbeddedResource Include="..\..\worldgen\policies\mission-scenes.json" LogicalName="MNBL.ProceduralWorld.mission-scenes.json" />
    <!-- MMR-45: the compiled world's factory policies (graph-validation.json "policies") and the campaign catalog pin, read by the activation. -->
    <EmbeddedResource Include="..\..\worldgen\policies\factions.json" LogicalName="MNBL.ProceduralWorld.factions.json" />
    <EmbeddedResource Include="..\..\worldgen\policies\rosters.json" LogicalName="MNBL.ProceduralWorld.rosters.json" />
    <EmbeddedResource Include="..\..\worldgen\policies\economy.json" LogicalName="MNBL.ProceduralWorld.economy.json" />
    <EmbeddedResource Include="..\..\worldgen\policies\startup.json" LogicalName="MNBL.ProceduralWorld.startup.json" />
    <EmbeddedResource Include="..\..\worldgen\policies\campaign-catalog.json" LogicalName="MNBL.ProceduralWorld.campaign-catalog.json" />
    <EmbeddedResource Include="..\..\worldgen\templates\settlements\prototypes.json" LogicalName="MNBL.ProceduralWorld.settlement-prototypes.json" />
    <EmbeddedResource Include="..\..\worldgen\templates\cultures\aserai.json" LogicalName="MNBL.ProceduralWorld.culture-aserai.json" />
    <EmbeddedResource Include="..\..\worldgen\templates\cultures\battania.json" LogicalName="MNBL.ProceduralWorld.culture-battania.json" />
    <EmbeddedResource Include="..\..\worldgen\templates\cultures\contract.json" LogicalName="MNBL.ProceduralWorld.culture-contract.json" />
    <EmbeddedResource Include="..\..\worldgen\templates\cultures\empire.json" LogicalName="MNBL.ProceduralWorld.culture-empire.json" />
    <EmbeddedResource Include="..\..\worldgen\templates\cultures\khuzait.json" LogicalName="MNBL.ProceduralWorld.culture-khuzait.json" />
    <EmbeddedResource Include="..\..\worldgen\templates\cultures\nord.json" LogicalName="MNBL.ProceduralWorld.culture-nord.json" />
    <EmbeddedResource Include="..\..\worldgen\templates\cultures\sturgia.json" LogicalName="MNBL.ProceduralWorld.culture-sturgia.json" />
    <EmbeddedResource Include="..\..\worldgen\templates\cultures\vlandia.json" LogicalName="MNBL.ProceduralWorld.culture-vlandia.json" />
    <EmbeddedResource Include="..\..\config\runtime-api-lock.json" LogicalName="MNBL.ProceduralWorld.runtime-api-lock.json" />
    <EmbeddedResource Include="..\..\worldgen\calibration\axis-sea-datum\calibration.json" LogicalName="MNBL.ProceduralWorld.axis-sea-datum-calibration.json" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml" />
    <Reference Include="netstandard" />
    <Reference Include="TaleWorlds.ScreenSystem"><HintPath>$(GameBin)\TaleWorlds.ScreenSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.InputSystem"><HintPath>$(GameBin)\TaleWorlds.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.DotNet"><HintPath>$(GameBin)\TaleWorlds.DotNet.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.MountAndBlade"><HintPath>$(GameBin)\TaleWorlds.MountAndBlade.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Library"><HintPath>$(GameBin)\TaleWorlds.Library.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Localization"><HintPath>$(GameBin)\TaleWorlds.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Core"><HintPath>$(GameBin)\TaleWorlds.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Engine"><HintPath>$(GameBin)\TaleWorlds.Engine.dll</HintPath><Private>false</Private></Reference>
    <!-- MMR-43: the Gauntlet setup screen (GauntletLayer; the input key view model). -->
    <Reference Include="TaleWorlds.Engine.GauntletUI"><HintPath>$(GameBin)\TaleWorlds.Engine.GauntletUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.MountAndBlade.ViewModelCollection"><HintPath>$(GameBin)\TaleWorlds.MountAndBlade.ViewModelCollection.dll</HintPath><Private>false</Private></Reference>
    <!-- MMR-46: the world preview's texture provider (TaleWorlds.GauntletUI.TextureProvider over a TwoDimension texture). -->
    <Reference Include="TaleWorlds.GauntletUI"><HintPath>$(GameBin)\TaleWorlds.GauntletUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.TwoDimension"><HintPath>$(GameBin)\TaleWorlds.TwoDimension.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ModuleManager"><HintPath>$(GameBin)\TaleWorlds.ModuleManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SandBox"><HintPath>$(GameRoot)\Modules\SandBox\bin\Win64_Shipping_Client\SandBox.dll</HintPath><Private>false</Private></Reference>
    <!-- War Sails (declared module dependency, pinned in config/runtime-api-lock.json): MMR-35 wraps its ClanShipOwnershipModel. -->
    <Reference Include="NavalDLC"><HintPath>$(GameRoot)\Modules\NavalDLC\bin\Win64_Shipping_Client\NavalDLC.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.CampaignSystem"><HintPath>$(GameBin)\TaleWorlds.CampaignSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ObjectSystem"><HintPath>$(GameBin)\TaleWorlds.ObjectSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.SaveSystem"><HintPath>$(GameBin)\TaleWorlds.SaveSystem.dll</HintPath><Private>false</Private></Reference>
    <!-- Bannerlord.Harmony (Workshop 2859188632): declared module dependency, never copied (docs/decisions/002). -->
    <Reference Include="0Harmony"><HintPath>$(WorkshopRoot)\2859188632\bin\Win64_Shipping_Client\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>

