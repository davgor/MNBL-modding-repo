      "typeIds": [],
      "syncData": [
        { "behavior": "MNBL.ProceduralWorld.CampaignRegistry.GeneratedStartupBehavior", "key": "_mnblStartupIntentIds", "type": "System.Collections.Generic.List<System.String>", "since": "MMR-34" },
        { "behavior": "MNBL.ProceduralWorld.CampaignRegistry.GeneratedStartupBehavior", "key": "_mnblStartupIntentHeroes", "type": "System.Collections.Generic.List<TaleWorlds.CampaignSystem.Hero>", "since": "MMR-34" }
      ],
      "headerKeys": {
        "mnbl.world.": ["schema", "id", "seed", "scene", "package", "manifestSha256", "placementSha256", "sceneFilesSha256", "documentsSha256", "periodic", "coordinatePolicy", "climate", "sceneXmlCrc", "navMeshCrc", "instance", "contentId"],
        "mnbl.save.": ["contract", "module", "moduleAssemblySha256", "game", "naval", "backend", "navigationCache", "saveIds", "worldIdentity"]
      },
      "note": "The module defines no saveable types: a world binding is header strings, and the only campaign data the module saves are two SyncData lists of installed types."
    },
