{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnbl.local/contracts/campaign.schema.json",
  "title": "MNBL campaign records v2",
  "description": "compiled/campaign/campaign.json version 2 (map epic 2; MMR-248 freezes the shape, MMR-252 writes the village quota, MMR-279 the population blocks, MMR-286 sourceName and ruins). Covered by the one map epic 2 bundle capability R11 with cells.bin v2 and weights.bin v2. Houses replace the one-ruling-clan-per-realm clans of version 1 (clean break: version 1 is refused). Every id is a world-prefixed game id of the id map; every uid a stable source uid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "worldSha256",
    "contentPolicySha256",
    "culturePolicySha256",
    "idMapSha256",
    "layoutSeed",
    "counts",
    "producer",
    "rules",
    "kingdoms",
    "wars",
    "houses",
    "mercenaryCompanies",
    "outlawClans",
    "wanderers",
    "wandererReserve",
    "ruins",
    "heroes",
    "towns",
    "castles",
    "villages",
    "ports",
    "exclusions",
    "notInstantiated",
    "villageQuota",
    "census"
  ],
  "properties": {
    "schema": {
      "const": "mnbl.campaign-records"
    },
    "version": {
      "const": 2
    },
    "worldSha256": {
      "$ref": "#/$defs/sha256"
    },
    "contentPolicySha256": {
      "$ref": "#/$defs/sha256"
