{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mnbl.world-bundle/1",
  "title": "MNBL world data bundle manifest",
  "description": "manifest.json of an immutable world data bundle (MMR-29), canonical JSON, written by worldbridge --bundle (docs/world-bundle.md). The bundle directory is named by worldContentId and holds source/ (the producer split), compiled/ (terrain, campaign records, travel graph, validation report and compatibility.json, which names the game and War Sails versions and the required capabilities inside the identity) and policies/ (every input policy, contract and calibration), plus DATA_READY ({schema mnbl.data-ready, version 1, worldContentId, manifestSha256}, written last). Nothing volatile is in it: no timestamps, absolute paths or logs (those go to the diagnostics directory). DATA_READY is not activation: an activation receipt (activation-receipt.schema.json) is written only by U03, outside the bundle. Validation rules beyond this schema (sorted unique inventory, totals, files equal to the inventory, no links, required files, policy and report hashes, compatibility.json equal to engine and requiredCapabilities) are worldbridge validate(), the C# WorldDataBundle and tools/summarize_bundle.py verify_bundle. Provenance members (source.recipe, source.producer, compiler, engine.runtimeLockSha256) record the first publication and may differ when identical content is published again; every other member must be equal for the bundle to be reused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "worldContentId",
    "worldContentAlgorithm",
    "inventory",
    "totals",
    "publication",
    "source",
    "compiler",
    "policies",
    "engine",
    "requiredCapabilities",
    "coordinates",
    "validation",
    "retention",
    "runtimeDerived",
    "migration"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?=.{1,120}$)(source|compiled|policies)(/(?![Cc][Oo][Nn](?:\\.|/|$)|[Pp][Rr][Nn](?:\\.|/|$)|[Aa][Uu][Xx](?:\\.|/|$)|[Nn][Uu][Ll](?:\\.|/|$)|[Cc][Oo][Mm][1-9](?:\\.|/|$)|[Ll][Pp][Tt][1-9](?:\\.|/|$))(?:[^/<>:\"|?*\\\\\\u0000-\\u001f]*[^/<>:\"|?*\\\\\\u0000-\\u001f. ]))+$",
      "description": "worldbridge safe_bundle_path: under source/, compiled/ or policies/; single / separators; at most 120 bytes (the pattern counts characters); no segment Windows cannot hold (empty, . or .., reserved characters, a trailing dot or space, a DOS device name with or without an extension)"
    }
  },
  "properties": {
    "schema": {
      "const": "mnbl.world-bundle"
    },
    "version": {
      "const": 1
    },
    "worldContentId": {
      "$ref": "#/$defs/sha256",
      "description": "identity::world_content over source/, compiled/ and policies/; also the bundle directory name"
    },
    "worldContentAlgorithm": {
      "type": "string"
    },
    "inventory": {
      "type": "array",
      "description": "every file of the bundle except manifest.json and DATA_READY, sorted by path",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "bytes"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "publication": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceIdentity",
        "worldSha256",
        "producer",
        "recipe"
      ],
      "properties": {
        "sourceIdentity": {
          "type": "string"
        },
        "worldSha256": {
          "$ref": "#/$defs/sha256"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lockSha256",
            "binarySha256",
            "sourceCommit",
            "generatorVersion"
          ],
          "properties": {
            "lockSha256": {
              "$ref": "#/$defs/sha256"
            },
            "binarySha256": {
              "$ref": "#/$defs/sha256"
            },
            "sourceCommit": {
              "type": "string"
            },
            "generatorVersion": {
              "type": "string"
            }
          }
        },
        "recipe": {
          "description": "the generation attempt's recipe (request.json), or null for a bundle made outside a generation",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sha256",
                "seed"
              ],
              "properties": {
                "sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "seed": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bridgeVersion",
        "binarySha256",
        "stages"
      ],
      "properties": {
        "bridgeVersion": {
          "type": "string"
        },
        "binarySha256": {
          "$ref": "#/$defs/sha256"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "description": "policy name (its file under policies/<name>.json) -> SHA-256",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gameVersion",
        "navalVersion",
        "runtimeLockSha256",
        "editor",
        "note"
      ],
      "properties": {
        "gameVersion": {
          "type": "string"
        },
        "navalVersion": {
          "type": "string"
        },
        "runtimeLockSha256": {
          "$ref": "#/$defs/sha256"
        },
        "editor": {
          "type": "null"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]{2}$"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionSha256",
        "axes",
        "logicalWidth",
        "logicalHeight",
        "strip",
        "poleMargin",
        "verticalScale",
        "seaDatum",
        "terrain"
      ],
      "properties": {
        "projectionSha256": {
          "$ref": "#/$defs/sha256"
        },
        "axes": {
          "type": "string"
        },
        "logicalWidth": {
          "type": "number"
        },
        "logicalHeight": {
          "type": "number"
        },
        "strip": {
          "type": "number"
        },
        "poleMargin": {
          "type": "number"
        },
        "verticalScale": {
          "type": "number"
        },
        "seaDatum": {
          "type": "number"
        },
        "terrain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "side",
            "columnOffset",
            "rowOffset"
          ],
          "properties": {
            "side": {
              "type": "integer"
            },
            "columnOffset": {
              "type": "integer"
            },
            "rowOffset": {
              "type": "integer"
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportPath",
        "reportSha256",
        "travelStatus"
      ],
      "properties": {
        "reportPath": {
          "$ref": "#/$defs/path"
        },
        "reportSha256": {
          "$ref": "#/$defs/sha256"
        },
        "travelStatus": {
          "const": "ok"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "references",
        "deletableWhen"
      ],
      "properties": {
        "kind": {
          "const": "world-data-bundle"
        },
        "references": {
          "type": "string"
        },
        "deletableWhen": {
          "type": "string"
        }
      }
    },
    "runtimeDerived": {
      "type": "string"
    },
    "migration": {
      "type": "string"
    }
  }
}
