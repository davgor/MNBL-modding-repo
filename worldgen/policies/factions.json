{
 "schema": "mnbl.factions",
 "version": 1,
 "notes": "MMR-31 faction definitions (docs/factions.md). Owner: FactionFactory (src/MNBL.ProceduralWorld/Campaign/FactionFactory.cs). Kingdoms and clans are intents over the MMR-27 compiler records: identities, relationships and ownership come from the generated world; assets (cultures, banner meshes, palette, icons, policies, title strings) are the installed public ones listed here. C03 (MMR-32) fills hero bodies and rosters, C04 (MMR-33) binds fiefs, C07 (MMR-36) proves registered closure.",
 "streams": {
  "rule": "value(stream, version, world prefix, entity id, draw) = first 8 bytes of sha256(\"mnbl.faction-stream/1\\n\" + stream + \"\\n\" + version + \"\\n\" + prefix + \"\\n\" + entity + \"\\n\" + draw), big-endian. Each purpose has its own stream and version, so a new or re-versioned cosmetic stream never changes ownership or another stream. Ownership and membership use no randomness at all.",
  "banner": 1,
  "colors": 1,
  "relations": 1
 },
 "sovereign": "MMR-27 resolves every realm's ruler: its sovereign, or the synthesized regent (regent:<realm uid>) when sovereign_uid is null. The ruler always leads the ruling clan. A kingdom intent without a ruler, ruling clan or capital is refused.",
 "rulingClan": {
  "source": "MMR-27 synthesizes one ruling clan per realm (clan:<realm uid>, \"House of {realm}\")",
  "keeps": "the ruler, every regent, and every lord whose role is not a vassal-clan leader role",
  "tierByFiefs": [
   {
    "minFiefs": 1,
    "tier": 4
   },
   {
    "minFiefs": 3,
    "tier": 5
   },
   {
    "minFiefs": 6,
    "tier": 6
   }
  ],
  "fiefs": "towns plus castles of the realm"
 },
 "vassalClans": {
  "leaderRoles": [
   "castellan",
   "pretender",
   "founder"
  ],
  "rule": "every living lord of a realm whose role is listed founds one vassal clan of that realm and leads it; its uid is clan:<lord uid> and its id the MMR-27 stable id of that uid (kind clan). Ordered by lord uid. Home: the realm capital (C04 may move it to a bound fief).",
  "nameTemplate": "House of {leader}",
  "tierByRole": {
   "castellan": 3,
   "pretender": 2,
   "founder": 2
  }
 },
 "resources": {
  "tier": "Clan.Deserialize sets Tier and renown from it (CalculateInitialRenown); the tier above is the clan resource this ticket sets",
  "goldAndInfluence": "not set here: hero gold and clan influence follow the installed new-game logic once C03 instantiates the heroes"
 },
 "diplomacy": {
  "stance": "neutral",
  "stanceRule": "every kingdom pair starts neutral: the source carries no realm relations, so no kingdom starts at war and wars are left to the campaign's own diplomacy. Kingdoms.xml carries no <relationships>: the installed Kingdom.Deserialize reads only the sign of a relationship value (below 0 calls FactionManager.DeclareWar, otherwise SetNeutral), stores no magnitude, and isAtWar can only add a war. Neutral is the engine default for a pair with no stance.",
  "baseRelation": 0,
  "spread": 20,
  "rulerRelation": "each unordered kingdom pair once, lower id first: the relation between the two rulers is baseRelation + round(spread * (2 * u - 1)), u from the relations stream for \"<a>|<b>\". It is a hero relation intent for C03 (MMR-32), applied once the heroes exist; it is not written to Kingdoms.xml",
  "clanRelations": "none set: clans start at the engine default"
 },
 "zeroTownRealm": {
  "action": "dissolve",
  "rule": "a realm with no town after the compiler and travel exclusions is not a kingdom: no kingdom or clan intent is emitted, its lords become unaffiliated and the dissolution is recorded with a reason. MMR-27 refuses a capital outside the realm's towns and MMR-28 never removes a town, so the pinned worlds have none; the rule closes the policy rather than keeping a kingdom with no valid initial state."
 },
 "texts": {
  "kingdomEncyclopedia": "The {realm} of the {civilization}, ruled from {capital}.",
  "clanEncyclopedia": "A noble house of the {realm}.",
  "escaping": "names keep their source text; localized strings are {=<id>}text with braces turned into parentheses (TextObject reads braces as variables); XML attributes are escaped; control characters are dropped"
 },
 "banners": {
  "layout": "two layers of 10 numbers: mesh.color1.color2.sizeX.sizeY.posX.posY.drawStroke.mirror.rotation; layer 1 the background, layer 2 the icon, as the installed noble clans and kingdoms use",
  "backgroundMesh": 11,
  "backgroundSize": 4922,
  "iconSize": 454,
  "center": 764,
  "icons": "the presentation culture's possible_clan_banner_icon_ids (worldgen/templates/cultures)",
  "colors": "two distinct palette colors per kingdom (background, icon), drawn in pairs from the colors stream; the ordered pair is unique among kingdoms (an equal or repeated pair draws the next pair). A kingdom's clans use the kingdom's colors",
  "iconRule": "the kingdom's icon is one banner-stream draw; each clan of the kingdom (ruling clan first, then the vassal clans by id) draws from the banner stream until its icon differs from the kingdom's and every earlier clan's of that kingdom. A kingdom with more banners than icons is refused",
  "unique": "every banner is unique in the world: colour pairs separate the kingdoms, icons separate a kingdom's own banners. The colors stream never changes an icon and the banner stream never changes a colour",
